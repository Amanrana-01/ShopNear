{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "node scripts/build-all.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/merchant",
      "destination": "/merchant/index.html"
    },
    {
      "source": "/merchant/((?!assets/).*)",
      "destination": "/merchant/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/((?!assets/).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!assets/|merchant/|admin/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/merchant/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
