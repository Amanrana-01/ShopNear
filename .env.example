# Postgres + PostGIS (see docker-compose.yml)
DATABASE_URL="postgresql://shopnear:shopnear@localhost:5436/shopnear?schema=public"

# API
PORT=4000
NODE_ENV=development

# Demo controls (Phase 6). Never enable in production.
DEMO_MODE=true

# Auth (Phase 2) — dev-only values, replaced per environment
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Prisma safety guard for destructive AI-invoked commands (e.g. `migrate
# reset`). Only set this after explicit human consent, scoped to a local
# dev database. Never set this against a production database.
PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION=

# ── AI search (Phase 7) ─────────────────────────────────────────────────────
# Server-side only. Never referenced from client code, never in the bundle,
# never committed — this file carries the name, `.env` carries the value.
# With no key set the API starts on the MOCK provider and logs that it did,
# so the demo and the test suite work with no credentials at all.
ANTHROPIC_API_KEY=

# Off by default. The browse/category/filter flow is unaffected either way.
AI_SEARCH_ENABLED=false

# Which catalogue the server builds its item index from. MUST match how the
# client resolves results, or item ids land in the wrong id space: `fixtures`
# for the client-side demo catalogue, `prisma` for the live database. The
# server never takes this from the client — it answers with `indexSource` and
# the client asserts it matches its own mode.
DATA_SOURCE=fixtures

# Safety net for a demo that must never run up a bill. Once the day's budget
# is spent, AI search silently falls back to keyword search and logs a visible
# warning the first time it trips.
AI_DAILY_TOKEN_BUDGET=200000
